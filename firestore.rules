rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Synced records for the Mac app + this web app. Each device keeps its own copy and
    // exchanges rows by updatedAt, which must be the server's clock. Deletes are
    // tombstones (deleted: true), so documents are never removed.
    match /users/{uid}/records/{id} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validRecord() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'json', 'deleted', 'updatedAt'])
          && d.kind in ['catch', 'hunt', 'phase', 'playthrough', 'badge']
          && d.json is string && d.json.size() < 100000
          && d.deleted is bool
          && d.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validRecord();
      allow delete: if false;
    }
  }
}
